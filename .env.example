# Required in production. Use the Supabase transaction pooler connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Optional for direct database tooling when the session pooler is available.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Optional production URL used by metadata, sitemap, and robots.
APP_URL=http://localhost:3000
