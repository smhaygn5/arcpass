# Required in production. Use the Supabase transaction pooler connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Optional for direct database tooling when the session pooler is available.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# Required for webhooks. Use a random value with at least 32 characters.
ARCPASS_WEBHOOK_ENCRYPTION_KEY=replace-with-a-random-32-character-or-longer-secret

# Required for Circle user-controlled email wallets.
# Create both values in the Circle Developer Console and enable email authentication with SMTP.
CIRCLE_API_KEY=TEST_API_KEY:replace-with-circle-api-key
NEXT_PUBLIC_CIRCLE_APP_ID=replace-with-circle-app-id

# Optional production URL used by metadata, sitemap, and robots.
APP_URL=http://localhost:3000
